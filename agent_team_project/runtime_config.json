{
  "backend_name": "inline-langgraph",
  "executors": [
    "产品经理",
    "架构师",
    "前端工程师",
    "后端工程师",
    "测试工程师"
  ],
  "host_policy": {
    "default_host": "cursor",
    "builtin_preferred_hosts": [
      "cursor",
      "vscode"
    ],
    "api_preferred_hosts": [
      "continue",
      "openai-codex"
    ],
    "subagent_provider_policy": {
      "default": "builtin_first",
      "builtin_first_hosts": [
        "cursor",
        "vscode"
      ],
      "api_first_hosts": [
        "continue",
        "openai-codex"
      ]
    }
  },
  "model_strategy": {
    "preferred_provider": "cursor_builtin",
    "fallback_provider": "api",
    "cursor_builtin": {
      "enabled": true,
      "mode": "Auto"
    },
    "api": {
      "enabled": true,
        "models": {
          "simple": [
          "Qwen/Qwen3-8B",
          "Pro/deepseek-ai/DeepSeek-V3.2"
          ],
          "complex": [
          "Pro/deepseek-ai/DeepSeek-V3.2",
          "Pro/MiniMaxAI/MiniMax-M2.5",
          "Pro/moonshotai/Kimi-K2.5"
          ]
        }
      }
  },
  "llm": {
    "temperature": 0.1,
    "timeout_seconds": 60
  },
  "run_skill": {
    "timeout_seconds": 300
  }
}
